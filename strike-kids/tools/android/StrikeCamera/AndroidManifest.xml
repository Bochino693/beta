<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lazersport.strikecamera">

    <uses-sdk android:minSdkVersion="21" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- TV Box não tem câmera própria: a webcam USB é opcional -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.external" android:required="false" />

    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.StrikeCamera"
            android:value="com.lazersport.strikecamera.StrikeCamera" />
    </application>
</manifest>

; STRIKE KIDS — boliche infantil 3D (Godot 4.6, renderizador Compatibility)
config_version=5

[application]

config/name="Strike Kids"
config/description="Strike Kids - boliche infantil arcade com Léo e Lia"
config/version="1.0.0"
run/main_scene="res://cenas/principal.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.16, 0.09, 0.32, 1)
boot_splash/show_image=false
config/icon="res://ui/icone_256.png"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[autoload]

Tela="*res://autoload/Tela.gd"
Ajustes="*res://autoload/Ajustes.gd"
Sons="*res://autoload/Sons.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
Fotos="*res://autoload/Fotos.gd"


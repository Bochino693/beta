<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lazersport.strikeserial">

    <uses-sdk android:minSdkVersion="21" />

    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- a TV ligou na tomada: abre o jogo (StrikeLigou); Android 10+: só
         com "sobrepor a outros apps" ou pelo aviso (notificação) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+: enxergar as telas iniciais da TV (InicioDaTv) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application>
        <!-- encaixe do Arduino: "Usar por padrão" guarda a permissão USB -->
        <activity
            android:name="com.lazersport.strikeserial.StrikeArduinoAtivo"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/strike_usb_arduino" />
        </activity>
        <!-- o jogo como TELA INICIAL da TV: abre sozinho ao ligar (InicioDaTv) -->
        <activity
            android:name="com.lazersport.strikeserial.StrikeInicioAtivo"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.lazersport.strikeserial.inicio"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name="com.lazersport.strikeserial.StrikeLigou"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Godot 3.6.3: plugin v1 (no Godot 4 era "org.godotengine.plugin.v2.");
             sem build Gradle, o montar_apk.sh põe isto no APK (manifesto.py) -->
        <meta-data
            android:name="org.godotengine.plugin.v1.StrikeSerial"
            android:value="com.lazersport.strikeserial.StrikeSerial" />
    </application>
</manifest>

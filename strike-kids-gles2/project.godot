[application]

config/name="Strike Kids"
config/description="Strike Kids - boliche infantil arcade com Bob e Mia (Lazer & Sport) - edicao OpenGL ES 2.0"
run/main_scene="res://cenas/principal.tscn"
boot_splash/image="res://ui/splash.png"
boot_splash/bg_color=Color( 0.024, 0.078, 0.188, 1 )
config/icon="res://ui/icone_256.png"
config/quit_on_go_back=false

[autoload]

Tela="*res://autoload/Tela.gd"
Ajustes="*res://autoload/Ajustes.gd"
Sons="*res://autoload/Sons.gd"
ArcadeControls="*res://autoload/ArcadeControls.gd"
ArduinoBridge="*res://autoload/ArduinoBridge.gd"
Fotos="*res://autoload/Fotos.gd"

[display]

window/size/width=1080
window/size/height=1920
window/size/fullscreen=true
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"compress/mode": 0,
"flags/filter": true,
"flags/mipmaps": true,
"flags/repeat": 0,
"process/fix_alpha_border": true
}


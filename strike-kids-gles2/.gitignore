# Godot 3: cache de importação e saídas de build
.import/
build/
*.apk
*.idsig
# comercial em vídeo (grande demais para o git: entregue à parte; refaz com
# divulgacao/ferramentas/montar_comercial.py)
divulgacao/comercial/*.mp4
divulgacao/**/__pycache__/
# gabinete: os PDFs de impressão de cada tema (dezenas de MB por tema) e as
# texturas da maquete 3D saem de novo com divulgacao/ferramentas/gerar_gabinete.py
divulgacao/adesivos/gabinete/*/[0-9][0-9]_*
divulgacao/adesivos/gabinete/_maquete/
